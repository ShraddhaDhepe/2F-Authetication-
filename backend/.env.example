# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_challenge
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Mock SMS (set to true to log OTPs to console instead of sending real SMS)
MOCK_SMS=true

# Twilio (optional - only needed if MOCK_SMS=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
